//開発環境設定
{
    "name": "Inventory Backend", //VS Code上での開発環境を識別
    "dockerComposeFile": "../docker-compose.yml", //既存のDocker Compose設定を利用するため
    "service": "backend", //開発対象をPython・FastAPIが動作するバックエンドに指定
    "workspaceFolder": "/app", //作業ディレクトリ
    "shutdownAction": "none" //VS Codeを閉じた時にコンテナを停止させない
}
